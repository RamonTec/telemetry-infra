{
  "realm": "telemetry",
  "enabled": true,
  "displayName": "Telemetry Platform",
  "sslRequired": "none",
  "roles": {
    "client": {
      "traccar-adapter": [
        {
          "name": "groups:write",
          "description": "Permite crear groups en traccar-adapter"
        },
        {
          "name": "devices:write",
          "description": "Permite registrar, deshabilitar y habilitar devices en traccar-adapter"
        }
      ],
      "core-service": [
        {
          "name": "tenant-admin",
          "description": "Administrador del tenant: usuarios, vehículos, GPS, suscripción"
        },
        {
          "name": "tenant-operator",
          "description": "Operador/despachador: mapa, historial, viajes y órdenes"
        },
        {
          "name": "tenant-viewer",
          "description": "Solo lectura"
        },
        {
          "name": "driver",
          "description": "Conductor: sus viajes y órdenes asignados"
        }
      ]
    },
    "realm": [
      {
        "name": "platform-operator",
        "description": "Operador de la plataforma: alta y administración de tenants (PADR-004)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "traccar-adapter",
      "name": "Traccar Adapter Service",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "core-service",
      "name": "Core Service (API Core)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "core-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "traccar-adapter-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "traccar-adapter",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "web-app",
      "name": "Frontend (Next.js)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3001/*"
      ],
      "webOrigins": [
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*"
      },
      "protocolMappers": [
        {
          "name": "core-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-service",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-core-service",
      "enabled": true,
      "serviceAccountClientId": "core-service",
      "clientRoles": {
        "traccar-adapter": [
          "groups:write",
          "devices:write"
        ]
      }
    },
    {
      "username": "operator",
      "email": "operator@platform.local",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Operator",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-operator"
      ]
    },
    {
      "username": "demo-admin",
      "email": "admin@demo.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "core-service": [
          "tenant-admin"
        ]
      },
      "attributes": {
        "tenant_id": [
          "01920000-0000-7000-8000-000000000001"
        ]
      }
    },
    {
      "username": "demo-dispatcher",
      "email": "dispatcher@demo.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Dispatcher",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "core-service": [
          "tenant-operator"
        ]
      },
      "attributes": {
        "tenant_id": [
          "01920000-0000-7000-8000-000000000001"
        ]
      }
    },
    {
      "username": "demo-viewer",
      "email": "viewer@demo.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Viewer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "core-service": [
          "tenant-viewer"
        ]
      },
      "attributes": {
        "tenant_id": [
          "01920000-0000-7000-8000-000000000001"
        ]
      }
    }
  ],
  "attributes": {
    "frontendUrl": "http://keycloak:8080"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_VIEW\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant\", \"validations\": {\"pattern\": {\"pattern\": \"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\", \"error-message\": \"tenant_id must be a UUID\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
