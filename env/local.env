# Local development values only. Never put real secrets here (this file is versioned).
TRACCAR_ADAPTER_IMAGE=traccar-adapter:local
LOG_LEVEL=debug

# MySQL (one database + user per service).
MYSQL_ROOT_PASSWORD=root-dev
CORE_DB_PASSWORD=core-dev
TELEMETRY_DB_PASSWORD=telemetry-dev

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Shared by Traccar (forward header) and traccar-adapter (webhook auth).
WEBHOOK_TOKEN=dev-webhook-token-0123456789

# First Traccar user, created by ./stack.sh bootstrap.
TRACCAR_ADMIN_EMAIL=admin@telemetry.local
TRACCAR_ADMIN_PASSWORD=admin

#API CORE
CORE_SERVICE_IMAGE=core-service:local
CORE_PORT=3001
CORE_DB_PASSWORD

# Host ports.
MYSQL_PORT=13306
NATS_PORT=4222
NATS_MONITOR_PORT=8222
KEYCLOAK_PORT=8080
TRACCAR_WEB_PORT=18082
TRACCAR_OSMAND_PORT=15055
ADAPTER_PORT=3000

# Client used by ./stack.sh smoke (realm-telemetry.json, local only).
SMOKE_CLIENT_ID=core-service
SMOKE_CLIENT_SECRET=core-service-secret
